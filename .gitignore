# Tauri desktop app (apps/desktop/) — build artifacts. The Vite dist and
# Tauri target are regenerated by CI via `pnpm install && pnpm build`.
apps/desktop/node_modules/
apps/desktop/dist/
apps/desktop/src-tauri/target/
# Regenerated by `tauri-build` on every build from capabilities/*.json.
apps/desktop/src-tauri/gen/

# JS/TS monorepo (Phase 5, Task 507.5): the root pnpm workspace + packages/*.
# node_modules are regenerated by `pnpm install`; generated proto code under
# packages/client/src/gen IS committed (carries @generated headers; regenerate
# with `pnpm -C packages/client generate`) so builds don't require the buf CLI.
/node_modules/
packages/*/node_modules/
apps/web/node_modules/
apps/web/dist/
# Playwright artifacts (regenerable; the e2e specs are the durable harness).
apps/web/test-results/
apps/web/playwright-report/
apps/web/e2e/__screenshots__/
apps/mobile/node_modules/

