{
  "expo": {
    "name": "Concerto",
    "slug": "concerto",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "concerto",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.concerto.app"
    },
    "android": {
      "package": "com.concerto.app",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Concerto uses the camera to scan the pairing QR code shown by your Core."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Concerto uses Face ID to protect your paired-Core credentials."
        }
      ],
      "./plugins/withConcertoIroh"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
